{
  "name": "@cuberat-js/markdown-parser",
  "version": "1.0.0",
  "description": "GitHub-flavored Markdown parser with HTML rendering, syntax highlighting, Mermaid diagrams, and footnote support",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "bin": {
    "markdown-parser": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test",
    "cli": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "markdown",
    "github-flavored-markdown",
    "gfm",
    "parser",
    "html",
    "ast",
    "converter"
  ],
  "author": "Don Owens <don@msquatch.com> (https://github.com/cuberat-js)",
  "homepage": "https://github.com/cuberat-js/markdownjs",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@primer/octicons": "^19.42.0",
    "commander": "^15.1.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "mermaid": "^12.3.0"
  }
}
